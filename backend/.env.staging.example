# Template ambiente staging — copiare in .env.staging sul server Ubuntu e compilare.
# .env.staging NON va committato (vedi .gitignore/.dockerignore).

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Logging (LOG_DIR iniettato da docker-compose.staging.yml, non serve qui) ──
# LOG_LEVEL: trace|debug|info|warn|error|fatal (default: info in production)
LOG_LEVEL=info

# ── Database (hostname = nome servizio in docker-compose.staging.yml) ────────
POSTGRES_PASSWORD=CAMBIA_QUESTA_PASSWORD
DATABASE_URL=postgresql://fiora:CAMBIA_QUESTA_PASSWORD@postgres:5432/fiora_staging

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIA_QUESTA_PASSWORD

# ── JWT (secret diverso da dev/prod) ──────────────────────────────────────────
JWT_SECRET=CAMBIA_QUESTO_SECRET
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# ── MQTT (HiveMQ Cloud — stesso cluster condiviso dev+staging) ───────────────
MQTT_BROKER_URL=mqtts://6c6f661a355149fbb2e308bc4a2ed846.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=

# ── MinIO (non ancora usato — Fase 5 rimandata) ──────────────────────────────
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PUBLIC_URL=

# ── Trefle API ────────────────────────────────────────────────────────────────
TREFLE_API_URL=
TREFLE_API_KEY=

# ── Expo Push Notifications ───────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ── Email transazionali (Resend, MEV-02) ─────────────────────────────────────
RESEND_API_KEY=
# Sandbox Resend (onboarding@resend.dev) senza dominio: invia solo all'email dell'account Resend.
# Con dominio verificato (SPF/DKIM/DMARC): no-reply@tuodominio.it
EMAIL_FROM=Fiora <onboarding@resend.dev>
# Base per i link nelle email (pagina fallback web che rilancia l'app, vedi app.ts /reset-password)
# In staging: IP Tailscale, raggiungibile anche fuori casa
APP_WEB_BASE_URL=http://100.102.50.17:3000

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=766129169137-gdjiobv67eij22llr46gt6ne4l8jugfa.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=766129169137-3g5ddn0p8imns29m1qlf3kqjns5cihql.apps.googleusercontent.com
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_CLIENT_SECRET=